# ===== LLM 配置 =====
# 任意 OpenAI 兼容端点均可。以下为火山方舟 Coding Plan 示例（也可用智谱/DeepSeek/OpenAI）：
# 注意：Coding Plan 订阅 key 必须用 /api/plan/v3 端点，标准方舟 key 用 /api/v3
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_API_KEY=your-api-key-here
LLM_MODEL=ark-code-latest

# 运行模式：live=真实调用 / mock=离线确定性伪结果（开发、CI 用）
# auto=先试真实调用，失败自动降级 mock（熔断保护，默认）
LLM_MODE=auto

# ===== 应用 =====
# CORS 允许的前端来源（Vite dev 默认 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 单次分析最大行数
MAX_ROWS=5000

# 审核 JSONL 日志单文件上限，达到后自动归档（默认 10MB）
REVIEW_LOG_MAX_BYTES=10485760
